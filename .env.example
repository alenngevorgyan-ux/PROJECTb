# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and as the ONLY allowed
# browser origin for the Case API in production (see server/config.ts CORS).
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: OAuth 2.0 Client ID for the Gmail rail (Google Identity
# Services). Not a secret — it is safe to expose to the browser and is
# returned as-is by GET /api/gmail/status. Falls back to firebase-applet-config.json
# ("oAuthClientId") if unset.
GOOGLE_CLIENT_ID="MY_GOOGLE_OAUTH_CLIENT_ID"

# ALLOWED_ORIGINS: optional comma-separated list of extra browser origins to
# allow via CORS in production, beyond APP_URL. Usually not needed.
ALLOWED_ORIGINS=""

# Redis (serverless deployment target only, e.g. Vercel): required for real
# Case persistence and the distributed send lock to work correctly across
# concurrent, ephemeral function instances. Auto-injected by a Vercel
# Marketplace Redis (Upstash) integration — you normally don't set these by
# hand. Leave unset for local dev / npm start / tests: the app falls back to
# file-backed persistence + an in-process lock automatically.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
